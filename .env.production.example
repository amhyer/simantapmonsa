# ══════════════════════════════════════════════════════════════════════════════
#  SIMANTAP — TEMPLATE KONFIGURASI PRODUKSI
#
#  Cara pakai:
#     cp .env.production.example .env.production   # lalu isi bagian <...>
#     # atau langsung:  cp .env.production.example .env
#
#  Berkas `.env` dan `.env.production` sudah di-gitignore — JANGAN commit.
#  Panduan lengkap: DEPLOYMENT.md
# ══════════════════════════════════════════════════════════════════════════════

APP_NAME=SIMANTAP
APP_TIMEZONE=Asia/Makassar

# ── WAJIB PRODUKSI ────────────────────────────────────────────────────────────
# Tiga baris di bawah adalah pembeda utama dari .env.example.
# APP_DEBUG=true di server live akan menampilkan stack trace + isi .env ke layar.
APP_ENV=production
APP_DEBUG=false
APP_URL=https://<domain-sekolah-anda>.sch.id

# Diisi otomatis:  php artisan key:generate
APP_KEY=

# ── Bahasa ────────────────────────────────────────────────────────────────────
APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=id_ID

# ── Logging ───────────────────────────────────────────────────────────────────
# 'debug' akan merekam query & payload ke disk. Produksi pakai warning/error.
LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning
LOG_DAILY_DAYS=14

# ── Enkripsi sandi ────────────────────────────────────────────────────────────
BCRYPT_ROUNDS=12

# ── Basis data (PostgreSQL) ───────────────────────────────────────────────────
# Pakai user aplikasi khusus, BUKAN superuser postgres. Lihat DEPLOYMENT.md §4.
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=simantap_db
DB_USERNAME=simantap_app
DB_PASSWORD=<password-kuat>
DB_SSLMODE=prefer

# ── Sesi & cookie ─────────────────────────────────────────────────────────────
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# WAJIB true bila situs disajikan lewat HTTPS (semestinya begitu di produksi).
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

# ── Cache, antrean, berkas ────────────────────────────────────────────────────
CACHE_STORE=database
CACHE_PREFIX=simantap_prod
QUEUE_CONNECTION=database
QUEUE_FAILED_DRIVER=database
FILESYSTEM_DISK=local
BROADCAST_CONNECTION=log

# ── Email ─────────────────────────────────────────────────────────────────────
# Tabel `users` SIMANTAP tidak punya kolom email, jadi aplikasi tidak mengirim
# email sendiri. Biarkan 'log' kecuali Anda menambahkan fitur notifikasi.
MAIL_MAILER=log
MAIL_FROM_ADDRESS="simantap@<domain-sekolah-anda>.sch.id"
MAIL_FROM_NAME="${APP_NAME}"

# ── Telescope (debug panel) ───────────────────────────────────────────────────
# Matikan di produksi. Bila perlu dinyalakan sementara untuk investigasi,
# akses tetap dibatasi admin yang namanya ada di TELESCOPE_ALLOWED_USERS.
TELESCOPE_ENABLED=false
TELESCOPE_ALLOWED_USERS=admin

# ── Fitur SIMANTAP ────────────────────────────────────────────────────────────
# CBT/Tryout ujian online. Jangan dinyalakan sebelum syarat docs/CBT.md terpenuhi:
# migrate + uji PostgreSQL + cron scheduler tiap menit + uji penerimaan sekolah.
SIMANTAP_CBT_ENABLED=false

# Mesin ujian terpadu (strangler). Biarkan default kecuali sedang rollback.
SIMANTAP_EXAM_ENGINE_TRYOUT=true
SIMANTAP_EXAM_ENGINE_CBT=true

# Penjaga seeder. Biarkan kosong/false: seeder contoh (admin123, guru123) akan
# MENOLAK berjalan di production. Set true hanya bila Anda benar-benar yakin.
SIMANTAP_ALLOW_SEED=false

# ── Cadangan otomatis ─────────────────────────────────────────────────────────
# `simantap:backup` berjalan tiap hari 02:00 lewat scheduler (lihat DEPLOYMENT.md §7).
BACKUP_DISK=local
BACKUP_DIRECTORY=backups
# Umur maksimum berkas cadangan (hari) sebelum dihapus otomatis. 0 = tanpa rotasi.
BACKUP_RETENTION_DAYS=30
# Opsional: nama disk LAIN untuk salinan offsite (mis. s3). Kosong = tidak menyalin.
BACKUP_COPY_DISK=

# ── Header keamanan ───────────────────────────────────────────────────────────
# Dipasang App\Http\Middleware\SecurityHeaders pada setiap respons.
# HSTS hanya dikirim lewat HTTPS. Jangan menaikkan HSTS_MAX_AGE sebelum yakin
# seluruh subdomain sudah ber-HTTPS.
SECURITY_HEADERS_ENABLED=true
SECURITY_HSTS_MAX_AGE=31536000
# SENGAJA KOSONG — memasang CSP akan mematahkan 22 tag CDN dan skrip inline.
# Lihat penjelasan di config/security.php sebelum mengisinya.
SECURITY_CSP=

# ── Presensi pegawai (geofence) ───────────────────────────────────────────────
PRESENSI_MENIT_SEBELUM_JADWAL=15
PRESENSI_MENIT_SETELAH_JADWAL=60
PRESENSI_AKURASI_GPS_MAKSIMAL=150

# ── Integrasi Dapodik (bridge) ────────────────────────────────────────────────
# Bridge berjalan di komputer operator sekolah, bukan di server ini.
DAPODIK_HOST=localhost
DAPODIK_PORT=5774
DAPODIK_PROTOCOL=http
DAPODIK_TIMEOUT=30

# ── Integrasi e-Rapor Kemdikbud ───────────────────────────────────────────────
ERAPOR_URL=https://erapor.kemdikbud.go.id/api
ERAPOR_API_KEY=<kunci-erapor>
ERAPOR_NPSN=<npsn-sekolah>

# ── Integrasi Google Sheets ───────────────────────────────────────────────────
# Disarankan: isi JSON service account satu baris penuh (tanpa berkas di disk).
GOOGLE_CREDENTIALS_JSON=
# Alternatif memakai berkas:
# GOOGLE_SERVICE_ACCOUNT_PATH=../storage/app/google-service-account.json

# ── API docs (Scramble) ───────────────────────────────────────────────────────
# Route /docs/api sudah dikunci RestrictedDocsAccess (hanya lingkungan local).
SCRAMBLE_DEV_TOOLS=false
API_VERSION=1.0.0
