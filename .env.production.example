# ══════════════════════════════════════════════════════════════════════════════
#  SIMANTAP — TEMPLATE KONFIGURASI PRODUKSI
#
#  Cara pakai:
#     cp .env.production.example .env.production   # lalu isi bagian <...>
#     # atau langsung:  cp .env.production.example .env
#
#  Berkas `.env` dan `.env.production` sudah di-gitignore — JANGAN commit.
#  Panduan lengkap: DEPLOYMENT.md
# ══════════════════════════════════════════════════════════════════════════════

APP_NAME=SIMANTAP
APP_TIMEZONE=Asia/Makassar

# ── WAJIB PRODUKSI ────────────────────────────────────────────────────────────
# Tiga baris di bawah adalah pembeda utama dari .env.example.
# APP_DEBUG=true di server live akan menampilkan stack trace + isi .env ke layar.
APP_ENV=production
APP_DEBUG=false
APP_URL=https://<domain-sekolah-anda>.sch.id

# Diisi otomatis:  php artisan key:generate
APP_KEY=

# ── Bahasa ────────────────────────────────────────────────────────────────────
APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=id_ID

# ── Logging ───────────────────────────────────────────────────────────────────
# 'debug' akan merekam query & payload ke disk. Produksi pakai warning/error.
LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning
LOG_DAILY_DAYS=14

# ── Enkripsi sandi ────────────────────────────────────────────────────────────
BCRYPT_ROUNDS=12

# ── Basis data (PostgreSQL) ───────────────────────────────────────────────────
# Pakai user aplikasi khusus, BUKAN superuser postgres. Lihat DEPLOYMENT.md §4.
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=simantap_db
DB_USERNAME=simantap_app
DB_PASSWORD=<password-kuat>
DB_SSLMODE=prefer

# ── Sesi & cookie ─────────────────────────────────────────────────────────────
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
# WAJIB true bila situs disajikan lewat HTTPS (semestinya begitu di produksi).
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

# ── Cache, antrean, berkas ────────────────────────────────────────────────────
CACHE_STORE=database
CACHE_PREFIX=simantap_prod
QUEUE_CONNECTION=database
QUEUE_FAILED_DRIVER=database
FILESYSTEM_DISK=local
BROADCAST_CONNECTION=log

# ── Email ─────────────────────────────────────────────────────────────────────
# Tabel `users` SIMANTAP tidak punya kolom email, jadi aplikasi tidak mengirim
# email sendiri. Biarkan 'log' kecuali Anda menambahkan fitur notifikasi.
MAIL_MAILER=log
MAIL_FROM_ADDRESS="simantap@<domain-sekolah-anda>.sch.id"
MAIL_FROM_NAME="${APP_NAME}"

# ── Telescope (debug panel) ───────────────────────────────────────────────────
# Matikan di produksi. Bila perlu dinyalakan sementara untuk investigasi,
# akses tetap dibatasi admin yang namanya ada di TELESCOPE_ALLOWED_USERS.
TELESCOPE_ENABLED=false
TELESCOPE_ALLOWED_USERS=admin

# ── Fitur SIMANTAP ────────────────────────────────────────────────────────────
# CBT/Tryout ujian online. Jangan dinyalakan sebelum syarat docs/CBT.md terpenuhi:
# migrate + uji PostgreSQL + cron scheduler tiap menit + uji penerimaan sekolah.
SIMANTAP_CBT_ENABLED=false
# Buffer jawaban CBT async (default false; aktifkan setelah uji beban).
SIMANTAP_CBT_BUFFER_ASYNC=false

# Mesin ujian terpadu (strangler). Biarkan default kecuali sedang rollback.
SIMANTAP_EXAM_ENGINE_TRYOUT=true
SIMANTAP_EXAM_ENGINE_CBT=true
# Pembaca dasbor/laporan dari engine exam_* (aktifkan setelah backfill + rekonsiliasi).
SIMANTAP_EXAM_ENGINE_READERS=false

# Mode multi-sekolah (isolasi data penuh per sekolah via tenant_id).
SIMANTAP_MULTI_TENANT=true
# Buka halaman Pendaftaran Akun Sekolah (/daftar-sekolah); registrasi guru/siswa/ortu tidak tersedia.
SIMANTAP_SCHOOL_REGISTRATION=true
# Wajibkan persetujuan Super Admin & verifikasi untuk setiap sekolah baru yang mendaftar mandiri di produksi.
SIMANTAP_SCHOOL_REGISTRATION_REQUIRE_APPROVAL=true
# Modul Kesiapan TKA (default true).
TKA_KESIAPAN_AKTIF=true
# Wajib ganti sandi saat login pertama untuk akun siswa baru.
SIMANTAP_FORCE_CHANGE_SISWA=true
# Batas akun per permintaan reset/generate massal agar tidak timeout HTTP.
SIMANTAP_RESET_MASSAL_MAX=100
# Telemetri pemakaian menu (agregat, tanpa identitas pengguna).
SIMANTAP_MENU_USAGE_TELEMETRY=true
# Bagian opsional landing publik.
SIMANTAP_LANDING_DEMO_VIDEO=false
SIMANTAP_LANDING_NEWSLETTER=false
# Foto siswa: private-by-default. Fallback public hanya sementara selama migrasi.
SIMANTAP_FOTO_SISWA_PER_PAGE=50
SIMANTAP_FOTO_FALLBACK_PUBLIC=false
SIMANTAP_FOTO_ZIP_MAX_ENTRIES=200
SIMANTAP_FOTO_ZIP_MAX_UNCOMPRESSED_BYTES=104857600
# CSP mode Report-Only (observasi, tidak memblokir).
SIMANTAP_CSP_REPORT_ONLY=false
# Daftar IP/CIDR reverse proxy tepercaya dipisah koma. Kosong = tidak percaya proxy mana pun.
# JANGAN pakai '*' bila server dapat diakses langsung.
SIMANTAP_TRUSTED_PROXIES=
# Komunikasi langsung ke mesin ZKTeco via TCP (kosong di hosting internet; pakai Bridge).
SIMANTAP_MESIN_HOST=
SIMANTAP_MESIN_PORT=4370
SIMANTAP_MESIN_LIVE_TIMEOUT=3

# Penjaga seeder. Biarkan kosong/false: seeder contoh (admin123, guru123) akan
# MENOLAK berjalan di production. Set true hanya bila Anda benar-benar yakin.
SIMANTAP_ALLOW_SEED=false

# ── Cadangan otomatis ─────────────────────────────────────────────────────────
# `simantap:backup` berjalan tiap hari 02:00 lewat scheduler (lihat DEPLOYMENT.md §7).
BACKUP_DISK=local
BACKUP_DIRECTORY=backups
# Umur maksimum berkas cadangan (hari) sebelum dihapus otomatis. 0 = tanpa rotasi.
BACKUP_RETENTION_DAYS=30
# Opsional: nama disk LAIN untuk salinan offsite (mis. s3). Kosong = tidak menyalin.
BACKUP_COPY_DISK=

# ── Header keamanan ───────────────────────────────────────────────────────────
# Dipasang App\Http\Middleware\SecurityHeaders pada setiap respons.
# HSTS hanya dikirim lewat HTTPS. Jangan menaikkan HSTS_MAX_AGE sebelum yakin
# seluruh subdomain sudah ber-HTTPS.
SECURITY_HEADERS_ENABLED=true
SECURITY_HSTS_MAX_AGE=31536000
# SENGAJA KOSONG — memasang CSP akan mematahkan 22 tag CDN dan skrip inline.
# Lihat penjelasan di config/security.php sebelum mengisinya.
SECURITY_CSP=

# ── Presensi pegawai (geofence) ───────────────────────────────────────────────
PRESENSI_MENIT_SEBELUM_JADWAL=15
PRESENSI_MENIT_SETELAH_JADWAL=60
PRESENSI_AKURASI_GPS_MAKSIMAL=150

# ── Integrasi Dapodik (bridge) ────────────────────────────────────────────────
# Bridge berjalan di komputer operator sekolah, bukan di server ini.
DAPODIK_HOST=localhost
DAPODIK_PORT=5774
DAPODIK_PROTOCOL=http
DAPODIK_TIMEOUT=30

# ── Integrasi e-Rapor Kemdikbud ───────────────────────────────────────────────
ERAPOR_URL=https://erapor.kemdikbud.go.id/api
ERAPOR_API_KEY=<kunci-erapor>
ERAPOR_NPSN=<npsn-sekolah>

# ── Integrasi Google Sheets ───────────────────────────────────────────────────
# Disarankan: isi JSON service account satu baris penuh (tanpa berkas di disk).
GOOGLE_CREDENTIALS_JSON=
# Alternatif memakai berkas:
# GOOGLE_SERVICE_ACCOUNT_PATH=../storage/app/google-service-account.json

# ── AI Gemini (Pembelajaran Mendalam) ─────────────────────────────────────────
# Opsional: kunci juga bisa diisi per-sekolah di Pengaturan Sekolah (terenkripsi).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_DAILY_QUOTA=60
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# ── API docs (Scramble) ───────────────────────────────────────────────────────
# Route /docs/api sudah dikunci RestrictedDocsAccess (hanya lingkungan local).
SCRAMBLE_DEV_TOOLS=false
API_VERSION=1.0.0

# ── Presensi mesin (server sekolah, opsional) ────────────────────────────────
# Hanya dipakai bila SIMANTAP baca database mesin presensi dari server ini.
# PRESENSI_MESIN_DB_PATH="D:\ZKTime\bin\att2000.mdb"
# PRESENSI_MESIN_DB_ENGINE=auto
# PRESENSI_MESIN_DB_TIMEOUT=120
# PRESENSI_MESIN_DB_SCRIPT=   (default: tools/attendance-mdb-export.ps1)
# PRESENSI_MESIN_DB_POWERSHELL=
# Alias lama (bila SIMANTAP_MESIN_HOST/PORT tidak diisi):
# PRESENSI_MESIN_DB_TCP_HOST=
# PRESENSI_MESIN_DB_TCP_PORT=4370
# PRESENSI_MESIN_COMM_KEY=
# PRESENSI_MESIN_ALLOW_TENANT=false
# PRESENSI_MESIN_USER_ID_PAD=10
# Wajib GPS saat scan QR pegawai (matikan hanya bila perangkat tidak punya GPS).
# PRESENSI_WAJIB_GPS_SCAN_QR_PEGAWAI=true
# PRESENSI_MESIN_JAM_MASUK=07:15
# PRESENSI_MESIN_JAM_MASUK_JENJANG_SD=07:15
# PRESENSI_MESIN_JAM_MASUK_JENJANG_MI=07:15
# PRESENSI_MESIN_JAM_MASUK_JENJANG_SMP=07:15
# PRESENSI_MESIN_JAM_MASUK_JENJANG_MTS=07:15
# PRESENSI_MESIN_JAM_MASUK_JENJANG_SMA=07:15
# PRESENSI_MESIN_JAM_MASUK_JENJANG_MA=07:15
# PRESENSI_MESIN_JAM_MASUK_JENJANG_SMK=07:15
# PRESENSI_MESIN_JAM_MASUK_JENJANG_SLB=07:15

# ── Presensi bridge (aplikasi pendamping) ───────────────────────────────────
# PRESENSI_BRIDGE_URL=http://127.0.0.1:8787
# PRESENSI_BRIDGE_KEY=
# PRESENSI_BRIDGE_STATE_PATH=  (default: storage/app/presensi-bridge-state.json)

# ── Bridge Dapodik (unduhan resmi untuk operator) ───────────────────────────
# DAPODIK_TOKEN=
# DAPODIK_BRIDGE_DOWNLOAD_URL=
# DAPODIK_BRIDGE_VERSION=
# DAPODIK_BRIDGE_SHA256=

# ── Header keamanan tambahan ────────────────────────────────────────────────
# SECURITY_FRAME_OPTIONS=SAMEORIGIN
# SECURITY_REFERRER_POLICY=strict-origin-when-cross-origin
