APP_NAME=SIMANTAP
APP_TIMEZONE=Asia/Makassar
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# Aplikasi berbahasa Indonesia (lihat config/app.php: locale default 'id')
APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# SIMANTAP berjalan di PostgreSQL (lihat README & config/database.php)
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=simantap_db
DB_USERNAME=postgres
DB_PASSWORD=
# Alternatif untuk mencoba cepat tanpa PostgreSQL (test suite memakai sqlite):
# DB_CONNECTION=sqlite

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# PRODUCTION: paksa cookie hanya lewat HTTPS
# SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Telescope (hanya non-local; set false di produksi bila tidak dipakai)
# TELESCOPE_ENABLED=false
# Daftar nama_pengguna admin yang boleh membuka /telescope, pisahkan koma
# TELESCOPE_ALLOWED_USERS=admin

# Dapodik WebService
# DAPODIK_HOST=localhost
# DAPODIK_PORT=5774
# DAPODIK_PROTOCOL=http
# DAPODIK_TIMEOUT=30

# Google Sheets Integration
# GOOGLE_SERVICE_ACCOUNT_PATH=../storage/app/google-service-account.json
# Alternatif tanpa file kunci di disk (disarankan untuk produksi):
# isi dengan JSON service account satu baris penuh
# GOOGLE_CREDENTIALS_JSON={"type":"service_account",...}

# PRODUCTION: set APP_DEBUG=false saat sudah live
