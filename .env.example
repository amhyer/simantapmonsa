APP_NAME=SIMANTAP_MONSA
APP_TIMEZONE=Asia/Makassar
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# Aplikasi berbahasa Indonesia (lihat config/app.php: locale default 'id')
APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DAILY_DAYS=14
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# SIMANTAP berjalan di PostgreSQL (lihat README & config/database.php)
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=simantap_db
DB_USERNAME=postgres
DB_PASSWORD=
# Alternatif untuk mencoba cepat tanpa PostgreSQL (test suite memakai sqlite):
# DB_CONNECTION=sqlite

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# PRODUCTION: paksa cookie hanya lewat HTTPS
# SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Telescope (require-dev; selalu false di produksi)
TELESCOPE_ENABLED=false
# Daftar nama_pengguna admin yang boleh membuka /telescope, pisahkan koma
# TELESCOPE_ALLOWED_USERS=admin

# Dapodik WebService
# DAPODIK_HOST=localhost
# DAPODIK_PORT=5774
# DAPODIK_PROTOCOL=http
# DAPODIK_TIMEOUT=30
# DAPODIK_TOKEN=
# URL unduhan SIMANTAP-Bridge.exe (GitHub Releases / object storage)
# DAPODIK_BRIDGE_DOWNLOAD_URL=
# DAPODIK_BRIDGE_VERSION=
# DAPODIK_BRIDGE_SHA256=

# Google Sheets Integration
# GOOGLE_SERVICE_ACCOUNT_PATH=../storage/app/google-service-account.json
# Alternatif tanpa file kunci di disk (disarankan untuk produksi):
# isi dengan JSON service account satu baris penuh
# GOOGLE_CREDENTIALS_JSON={"type":"service_account",...}

# PRODUCTION: set APP_DEBUG=false saat sudah live

# QR mandiri pegawai memerlukan titik GPS aktif bila true.
# Set false untuk kebijakan QR tanpa GPS (mis. sekolah yang memakai mesin fingerprint
# sebagai sumber utama dan ingin scan QR dari komputer/scanner USB tanpa GPS).
PRESENSI_WAJIB_GPS_SCAN_QR_PEGAWAI=false

# Presensi mesin fingerprint (Attendance Management / ZKTeco)
# Batas jam masuk; scan setelah jam ini ditandai terlambat.
# PRESENSI_MESIN_JAM_MASUK=07:15
# Lokasi database Attendance Management. Kosongkan bila ingin dicari otomatis
# di D:\ZKTime\bin\att2000.mdb dan folder pemasangan umum lainnya.
# PRESENSI_MESIN_DB_PATH="D:\\ZKTime\\bin\\att2000.mdb"
# auto | pdo_odbc | powershell | tcp
# PRESENSI_MESIN_DB_ENGINE=auto
# PRESENSI_MESIN_DB_TIMEOUT=120
# Komunikasi langsung ke mesin ZKTeco via TCP (port default: 4370).
# Komunikasi langsung ke mesin ZKTeco via TCP (opsional, khusus jaringan lokal).
# Biarkan kosong di hosting internet — gunakan jalur Bridge (/api/presensi/mesin/sinkron).
SIMANTAP_MESIN_HOST=
SIMANTAP_MESIN_PORT=4370
SIMANTAP_MESIN_LIVE_TIMEOUT=3
# Alias lama yang tetap didukung bila SIMANTAP_MESIN_HOST/PORT tidak diisi:
# PRESENSI_MESIN_DB_TCP_HOST=
# PRESENSI_MESIN_DB_TCP_PORT=4370
# Communication key mesin (menu Komunikasi). Kosong/0 = kunci bawaan.
# PRESENSI_MESIN_COMM_KEY=0
# Panjang No. PIN ZKTime (10 digit berawalan nol). 0 = apa adanya.
# PRESENSI_MESIN_USER_ID_PAD=10
# Izinkan tarik langsung pada mode multi-sekolah. Hanya untuk instalasi satu
# sekolah yang database mesinnya berada di server ini. Default: false.
# PRESENSI_MESIN_ALLOW_TENANT=false

# CBT pilihan ganda: aktifkan setelah migrate + PHPUnit + scheduler siap (docs/CBT.md).
SIMANTAP_CBT_ENABLED=false
# Mode multi-sekolah (default false = mode satu sekolah; lihat prasyarat di docs/DEPLOY.md)
SIMANTAP_MULTI_TENANT=false
# Modul Kesiapan TKA (default true)
TKA_KESIAPAN_AKTIF=true
# Backup otomatis (php artisan simantap:backup)
BACKUP_DISK=local
BACKUP_DIRECTORY=backups
BACKUP_RETENTION_DAYS=14
# BACKUP_COPY_DISK=
# Header keamanan HTTP (aktif secara default)
SECURITY_HEADERS_ENABLED=true
SECURITY_HSTS_MAX_AGE=31536000
# Agregat penggunaan halaman untuk evaluasi menu; tidak menyimpan identitas pengguna.
SIMANTAP_MENU_USAGE_TELEMETRY=true
# Fase 3: pembaca dasbor/laporan dari engine exam_* (aktifkan setelah backfill + rekonsiliasi)
SIMANTAP_EXAM_ENGINE_READERS=false
# Wajib ganti sandi saat login pertama untuk akun siswa baru (guru selalu wajib)
SIMANTAP_FORCE_CHANGE_SISWA=true
# Batas akun per permintaan reset/generate massal agar tidak timeout HTTP
SIMANTAP_RESET_MASSAL_MAX=100
# Tampilkan bagian Video Demo dan Newsletter pada halaman landing (default: false)
SIMANTAP_LANDING_DEMO_VIDEO=false
SIMANTAP_LANDING_NEWSLETTER=false
# Jumlah baris per halaman pada halaman Foto Siswa
SIMANTAP_FOTO_SISWA_PER_PAGE=50
# Fallback baca foto siswa lama di disk public melalui route terautentikasi.
# Default false (private-by-default). Set true hanya sementara selama migrasi ke disk private.
SIMANTAP_FOTO_FALLBACK_PUBLIC=false
# Batas entri & total ukuran terdekompresi (byte) pada unggah ZIP foto siswa
SIMANTAP_FOTO_ZIP_MAX_ENTRIES=200
SIMANTAP_FOTO_ZIP_MAX_UNCOMPRESSED_BYTES=104857600
# Content-Security-Policy mode Report-Only (observasi, tidak memblokir)
SIMANTAP_CSP_REPORT_ONLY=false
# Daftar IP/CIDR reverse proxy tepercaya dipisah koma (mis. 127.0.0.1 untuk Nginx lokal).
# Default kosong = tidak mempercayai proxy mana pun. JANGAN pakai '*' bila server dapat diakses langsung.
# SIMANTAP_TRUSTED_PROXIES=127.0.0.1
