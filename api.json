                    "user_id": {
                        "type": [
                            "integer",
                            "null"
                        ]
                    },
                    "sekolah_npsn": {
                        "type": [
                            "string",
                            "null"
                        ]
                    },
                    "nama_sekolah": {
                        "type": [
                            "string",
                            "null"
                        ]
                    },
                    "tipe": {
                        "type": "string"
                    },
                    "tahun_ajaran": {
                        "type": [
                            "string",
                            "null"
                        ]
                    },
                    "semester": {
                        "type": [
                            "string",
                            "null"
                        ]
                    },
                    "total_data": {
                        "type": "integer"
                    },
                    "berhasil": {
                        "type": "integer"
                    },
                    "gagal": {
                        "type": "integer"
                    },
                    "diperbarui": {
                        "type": "integer"
                    },
                    "dilewati": {
                        "type": "integer"
                    },
                    "ip_address": {
                        "type": [
                            "string",
                            "null"
                        ]
                    },
                    "started_at": {
                        "type": [
                            "string",
                            "null"
                        ],
                        "format": "date-time"
                    },
                    "finished_at": {
                        "type": [
                            "string",
                            "null"
                        ],
                        "format": "date-time"
                    },
                    "duration_seconds": {
                        "type": [
                            "integer",
                            "null"
                        ]
                    },
                    "created_at": {
                        "type": [
                            "string",
                            "null"
                        ],
                        "format": "date-time"
                    },
                    "updated_at": {
                        "type": [
                            "string",
                            "null"
                        ],
                        "format": "date-time"
                    }
                },
                "required": [
                    "id",
                    "uuid",
                    "user_id",
                    "sekolah_npsn",
                    "nama_sekolah",
                    "tipe",
                    "tahun_ajaran",
                    "semester",
                    "total_data",
                    "berhasil",
                    "gagal",
                    "diperbarui",
                    "dilewati",
                    "ip_address",
                    "started_at",
                    "finished_at",
                    "duration_seconds",
                    "created_at",
                    "updated_at"
                ],
                "title": "DapodikSyncLog"
            },
            "Semester": {
                "type": "object",
                "properties": {
                    "id": {
                        "type": "integer"
                    },
                    "semester_id": {
                        "type": "string"
                    },
                    "tahun_ajaran": {
                        "type": "string"
                    },
                    "nama_semester": {
                        "type": "string"
                    },
                    "created_at": {
                        "type": [
                            "string",
                            "null"
                        ],
                        "format": "date-time"
                    },
                    "updated_at": {
                        "type": [
                            "string",
                            "null"
                        ],
                        "format": "date-time"
                    }
                },
                "required": [
                    "id",
                    "semester_id",
                    "tahun_ajaran",
                    "nama_semester",
                    "created_at",
                    "updated_at"
                ],
                "title": "Semester"
            }
        },
        "responses": {
            "ValidationException": {
                "description": "Validation error",
                "content": {
                    "application/json": {
                        "schema": {
                            "type": "object",
                            "properties": {
                                "message": {
                                    "type": "string",
                                    "description": "Errors overview."
                                },
                                "errors": {
                                    "type": "object",
                                    "description": "A detailed description of each field that failed validation.",
                                    "additionalProperties": {
                                        "type": "array",
                                        "items": {
                                            "type": "string"
                                        }
                                    }
                                }
                            },
                            "required": [
                                "message",
                                "errors"
                            ]
                        }
                    }
                }
            }
        }
    }
}